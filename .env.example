# Copy to .env to override defaults. Never commit real secrets here.
PORT=3000
HOST=127.0.0.1
# Bearer token required on every POST /mcp (Authorization: Bearer <token>).
# Binding to a non-loopback HOST without this set is refused at startup.
MCP_AUTH_TOKEN=replace-me-with-a-long-random-string
LEG_BIN=leg
# LEG_HOME is read by leg itself (default ~/.leg, legacy fallback ~/.baton).
